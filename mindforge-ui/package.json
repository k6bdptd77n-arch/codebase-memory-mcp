{
  "name": "mindforge-ui",
  "version": "0.1.0",
  "private": true,
  "description": "MindForge desktop UI — a Claude Code-style GUI with an integrated terminal (real PTY) and live explanation panels (reasoning/steps, annotated commands, MindForge layer state, file diffs).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "shot": "electron . --shot",
    "test": "node --test",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check projectcore.js && node --check providercore.js && node --check graphcore.js && node --check filecore.js && node --check i18n.js && node --check views/board.js && node --check views/brain.js && node --check views/metrics.js && node --check views/plan.js && node --check views/settings.js",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.mindforge.control",
    "productName": "MindForge Control",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "i18n.js",
      "projectcore.js",
      "providercore.js",
      "graphcore.js",
      "filecore.js",
      "index.html",
      "styles.css",
      "views/**",
      "fonts/**",
      "demo-project/**"
    ],
    "extraResources": [
      { "from": "../fablize", "to": "fablize",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"] },
      { "from": "../crew", "to": "crew",
        "filter": ["**/*", "!.venv/**", "!**/__pycache__/**", "!**/*.pyc"] },
      { "from": "../build/c/codebase-memory-mcp", "to": "build/c/codebase-memory-mcp" }
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "afterSign": "build/notarize.js"
  }
}
