{
  "_comment": "Verify recipes per stack — the gate a story is held to. A closed loop is only as strong as its --check, and these are the sane defaults so authoring a plan isn't expert-only. 'allow' entries extend a project's crew.json hand.allow for the worktree agent.",
  "recipes": {
    "node-npm":  { "label": "Node · npm",   "test": "npm test",        "build": "npm run build",     "allow": ["Bash(npm test:*)", "Bash(npm run:*)"] },
    "node-pnpm": { "label": "Node · pnpm",  "test": "pnpm test",       "build": "pnpm build",        "allow": ["Bash(pnpm:*)"] },
    "node-yarn": { "label": "Node · yarn",  "test": "yarn test",       "build": "yarn build",        "allow": ["Bash(yarn:*)"] },
    "next":      { "label": "Next.js",      "test": "npm test",        "build": "next build",        "allow": ["Bash(npm test:*)", "Bash(npm run:*)"] },
    "python":    { "label": "Python · pytest", "test": "python3 -m pytest -q", "build": "python3 -m build", "allow": ["Bash(pytest:*)", "Bash(python3:*)"] },
    "python-poetry": { "label": "Python · poetry", "test": "poetry run pytest -q", "build": "poetry build", "allow": ["Bash(poetry run:*)"] },
    "go":        { "label": "Go",           "test": "go test ./...",   "build": "go build ./...",     "allow": ["Bash(go test:*)"] },
    "rust":      { "label": "Rust · cargo", "test": "cargo test",      "build": "cargo build",        "allow": ["Bash(cargo test:*)"] },
    "deno":      { "label": "Deno",         "test": "deno test -A",    "build": "deno check",         "allow": ["Bash(deno test:*)"] },
    "make":      { "label": "Makefile",     "test": "make test",       "build": "make build",         "allow": ["Bash(make:*)"] }
  }
}
